# PORT: Port the server listens on. Defaults to 3000 if not set.
PORT=3000

# NODE_ENV: Set to "production" for the built/deployed app.
# In non-production, the server uses Vite's dev middleware with HMR.
NODE_ENV=development

# VITE_SERVER_URL: Only needed if frontend and backend are hosted separately
# (e.g. frontend on Firebase Hosting, backend on Render/Railway/Fly).
# Leave empty/unset for a same-origin (monolithic) deploy.
# Example: VITE_SERVER_URL=https://masa-oyunlari-api.onrender.com
VITE_SERVER_URL=
