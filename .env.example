# PORT: Port the server listens on. Defaults to 3000 if not set.
PORT=3000

# NODE_ENV: Set to "production" for the built/deployed app.
# In non-production, the server uses Vite's dev middleware with HMR.
NODE_ENV=development

# VITE_SERVER_URL: Only needed if frontend and backend are hosted separately
# (e.g. frontend on Firebase Hosting, backend on Render/Railway/Fly).
# Leave empty/unset for a same-origin (monolithic) deploy.
# Example: VITE_SERVER_URL=https://masa-oyunlari-api.onrender.com
VITE_SERVER_URL=

# --- Online accounts (optional) --------------------------------------------
# Without these, the app runs exactly as before: anonymous names only, no
# login, in-memory-only leaderboard. Set all of them (client + server side)
# to require an account for real online multiplayer (bot testing still works
# without any of this). See README.md > "Online-Konten einrichten" for the
# full step-by-step Firebase Console instructions.

# Client-side (public, safe to ship in the built frontend) - from
# Firebase Console > Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side (SECRET - never commit, set only as env vars on Render) - from
# Firebase Console > Project settings > Service accounts > Generate new
# private key. Paste the private_key value including the literal \n's.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
